# =====================================================
# ASSISTANT.BD - ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and fill in your values
# =====================================================

# ============ DATABASE ============
DATABASE_URL=postgresql://admin:secure_password_change_me@localhost:5432/assistant_bd
DATABASE_POOL_SIZE=20

# ============ REDIS ============
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============ JWT & AUTH ============
JWT_SECRET=your-super-secret-jwt-key-change-in-production-!@#$%
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=another-super-secret-key-!@#$%^&*()
REFRESH_TOKEN_EXPIRES_IN=30d

# ============ AI/LLM SERVICES ============
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============ MESSAGING SERVICES ============
# WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Facebook Messenger
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=

# Instagram
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============ PAYMENT SERVICES ============
# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_WEBHOOK_SECRET=whsec_test_...

# bKash (Bangladesh)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_ENVIRONMENT=sandbox

# Nagad (Bangladesh)
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PASSWORD=

# ============ APPLICATION ============
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ============ MONITORING & LOGGING ============
LOG_LEVEL=debug
LOG_FORMAT=json

# Datadog (Optional)
DATADOG_API_KEY=
DATADOG_ENV=development

# Sentry (Error tracking)
SENTRY_DSN=

# ============ VECTOR DATABASE (for AI memory) ============
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-west1-gcp
VECTOR_DB_TYPE=pinecone  # or milvus, weaviate

# ============ FILE STORAGE ============
S3_BUCKET=assistant-bd-uploads
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ============ FEATURES & FLAGS ============
ENABLE_VOICE_AGENT=true
ENABLE_VECTOR_MEMORY=true
ENABLE_ANALYTICS=true
ENABLE_WEBHOOKS=true

# ============ DEPLOYMENT ============
ENVIRONMENT=development
VERSION=1.0.0
BUILD_ID=local

# ============ SECURITY ============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000
